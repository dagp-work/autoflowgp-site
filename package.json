{
  "name": "autoflowgp-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site vitrine et blog d'AutoFlowGP, agence d'automatisation no-code. Eleventy + Tailwind CSS, déployé sur Netlify.",
  "scripts": {
    "dev:css": "tailwindcss -i src/styles/tailwind.css -o public/assets/main.css --watch",
    "dev:11ty": "eleventy --serve",
    "dev": "npm-run-all --parallel dev:*",
    "build:css": "tailwindcss -i src/styles/tailwind.css -o public/assets/main.css --minify",
    "build": "npm run build:css && eleventy"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "luxon": "^3.7.2",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^3.4.17"
  },
  "engines": {
    "node": ">=18"
  }
}
