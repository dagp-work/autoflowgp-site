<section class="grid md:grid-cols-3 gap-6">
{% set plans = [
  { name: "Starter", price: "150–250 €",
    features: ["Audit de base","1–2 automatisations","Notion simple","Support 7 jours"] },
  { name: "Pro", price: "400–600 €",
    features: ["Audit complet","3–5 automatisations","Mini-CRM Notion","1 mois maintenance","Formation courte"] },
  { name: "Premium", price: "800–1 200 €",
    features: ["Conseil stratégique","Automatisations avancées","CRM + Reporting","Formation complète + support"] }
] %}
{% for p in plans %}
  <div class="card flex flex-col{% if loop.index == 2 %} glass-fluted{% endif %}">
    <p class="eyebrow relative">Pack 0{{ loop.index }}</p>
    <h3 class="relative mt-2 text-xl font-semibold">{{ p.name }}</h3>
    <p class="relative mt-3 text-4xl font-black tracking-tight text-slate-900 dark:text-white">{{ p.price }}</p>
    <div class="brand-rule relative mt-4 w-12" aria-hidden="true"></div>
    <ul class="relative mt-5 space-y-2 flex-1">
      {% for f in p.features %}
      <li class="flex items-start gap-2"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary-600" aria-hidden="true"></span>{{ f }}</li>
      {% endfor %}
    </ul>
    <a href="/contact/" class="btn-primary relative mt-6 self-start">Demander un devis</a>
  </div>
{% endfor %}
</section>
