<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {# Titre d'onglet / Google : ajoute « | AutoFlowGP » quand la marque n'y est pas et que ça tient en 60 caractères #}
  {% set pageTitle = title or site.name %}
  {% if site.name not in pageTitle and (pageTitle | length) + (site.name | length) + 3 <= 60 %}{% set pageTitle = pageTitle + " | " + site.name %}{% endif %}
  {% set pageDescription = description or site.description %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}" />
  {# URL officielle : évite que Google indexe aussi les versions de test *.netlify.app #}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
  {% if noindex %}<meta name="robots" content="noindex" />{% endif %}
  {# Validation Google Search Console (propriété https://www.autoflowgp.com/) — ne pas supprimer #}
  <meta name="google-site-verification" content="BBjvKVB3gQTOsTLPLL2l1PUMvHmmH4TGztjl3GWPwRw" />
  {# Aperçu quand un lien est partagé (WhatsApp, LinkedIn, Facebook, X…) #}
  <meta property="og:type" content="{{ 'article' if page.url.startsWith('/blog/posts/') else 'website' }}" />
  <meta property="og:site_name" content="{{ site.name }}" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:title" content="{{ pageTitle }}" />
  <meta property="og:description" content="{{ pageDescription }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:image" content="{{ site.url }}/assets/img/og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png" />
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
  <link rel="stylesheet" href="/assets/main.css" />
  <script defer src="/assets/js/alpine.min.js"></script>
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-black dark:text-slate-200">
  <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] btn-primary">Aller au contenu</a>
  <header x-data="{ open: false }" @keydown.escape.window="open = false" class="sticky top-0 z-50 border-b bg-white/80 backdrop-blur dark:bg-black/80">
    <nav class="container-xl flex items-center justify-between h-16" aria-label="Navigation principale">
      <a href="/" class="flex items-center gap-2">
        <img src="/assets/img/logo-128.png" alt="Logo AutoFlowGP" width="40" height="40" class="h-10 w-10 rounded-lg" />
        <span class="font-semibold">AutoFlowGP</span>
      </a>

      <!-- Menu ordinateur -->
      <ul class="hidden md:flex items-center gap-6">
        {% for item in site.navigation %}
        <li><a href="{{ item.href }}" class="hover:text-primary-700 dark:hover:text-primary-300{% if page.url == item.href %} text-primary-700 dark:text-primary-400 font-medium{% endif %}">{{ item.label }}</a></li>
        {% endfor %}
      </ul>

      <!-- Bouton menu mobile -->
      <button type="button" @click="open = !open" class="md:hidden -mr-2 p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-neutral-800"
              :aria-expanded="open.toString()" aria-expanded="false" aria-controls="menu-mobile" aria-label="Ouvrir le menu">
        <svg x-show="!open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg x-show="open" x-cloak class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </nav>

    <!-- Menu mobile -->
    <ul id="menu-mobile" x-show="open" x-cloak x-transition.opacity @click.outside="open = false"
        class="md:hidden border-t bg-white dark:bg-black container-xl py-2">
      {% for item in site.navigation %}
      <li><a href="{{ item.href }}" @click="open = false" class="block py-3 text-lg hover:text-primary-700 dark:hover:text-primary-300{% if page.url == item.href %} text-primary-700 dark:text-primary-400 font-medium{% endif %}">{{ item.label }}</a></li>
      {% endfor %}
    </ul>
  </header>

  <main id="contenu" class="container-xl py-10 min-h-[70vh]">
    {{ content | safe }}
  </main>

  <footer class="mt-16 border-t py-10 text-sm text-slate-500 dark:text-slate-400">
    <div class="container-xl flex flex-col sm:flex-row gap-4 sm:items-center sm:justify-between">
      <p>© {{ "now" | date("yyyy") }} {{ site.name }}. Tous droits réservés.</p>
      <p><a href="/" class="hover:text-primary-700 dark:hover:text-primary-300">Mentions légales</a></p>
    </div>
  </footer>
</body>
</html>