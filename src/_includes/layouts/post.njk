  <div class="mt-4 flex flex-wrap gap-3">
    <a href="/contact/" class="btn-primary">Parler de votre cas</a>
    <a href="/services/" class="inline-block px-4 py-2 rounded-lg border border-slate-300 hover:border-primary-600">Voir les packs</a>
